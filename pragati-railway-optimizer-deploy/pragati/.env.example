# PRAGATI — Environment Configuration Example
PORT=5000
NODE_ENV=production

# Only needed if the frontend is deployed on a DIFFERENT host than the backend
# (e.g. frontend on Vercel, backend on Render). Leave unset for single-service
# deploys — the frontend will call same-origin /api automatically.
# VITE_API_URL=https://your-backend-host.onrender.com

# RailRadar API Key (Get from https://railradar.in/docs)
RAILRADAR_API_KEY=YOUR_RAILRADAR_API_KEY_HERE
VITE_RAILRADAR_API_KEY=YOUR_RAILRADAR_API_KEY_HERE

# Supabase Database Configuration (Get from https://supabase.com/dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
